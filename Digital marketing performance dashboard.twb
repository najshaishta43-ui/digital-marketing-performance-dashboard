    <worksheet name='Sheet 3'>
      <layout-options>
        <title>
          <formatted-text>
            <run fontcolor='#000000' fontname='Britannic Bold'>&quot; Top 3 / Bottom 3 campaigns by ROI &quot;</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='Campaign Data (Digital_Marketing_Performance_Dashboard)' name='federated.1tgqgev1fo243u19y7c690bbvb5r' />
          </datasources>
          <datasource-dependencies datasource='federated.1tgqgev1fo243u19y7c690bbvb5r'>
            <column caption='Calculation1' datatype='string' name='[Calculation_1161124440289283]' role='measure' type='nominal'>
              <calculation class='tableau' formula='IF RANK(SUM([ROI (x)]), &apos;desc&apos;) &lt;= 3 THEN &apos;Top 3&apos; ELSEIF RANK(SUM([ROI (x)]), &apos;asc&apos;) &lt;= 3 THEN &apos;Bottom 3&apos; ELSE &apos;Other&apos; END'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
            <column datatype='string' name='[Campaign Name]' role='dimension' type='nominal' />
            <column datatype='real' name='[ROI (x)]' role='measure' type='quantitative' />
            <column-instance column='[ROI (x)]' derivation='Avg' name='[avg:ROI (x):qk]' pivot='key' type='quantitative' />
            <column-instance column='[Campaign Name]' derivation='None' name='[none:Campaign Name:nk]' pivot='key' type='nominal' />
            <column-instance column='[Calculation_1161124440289283]' derivation='User' name='[usr:Calculation_1161124440289283:nk]' pivot='key' type='nominal'>
              <table-calc ordering-type='Rows' />
            </column-instance>
          </datasource-dependencies>
          <shelf-sorts>
            <shelf-sort-v2 dimension-to-sort='[federated.1tgqgev1fo243u19y7c690bbvb5r].[none:Campaign Name:nk]' direction='DESC' is-on-innermost-dimension='true' measure-to-sort-by='[federated.1tgqgev1fo243u19y7c690bbvb5r].[avg:ROI (x):qk]' shelf='columns' />
          </shelf-sorts>
          <aggregation value='true' />
        </view>
        <style>
          <style-rule element='refline'>
            <format attr='fill-above' id='refline1' value='#00000000' />
            <format attr='fill-below' id='refline1' value='#00000000' />
          </style-rule>
        </style>
        <panes>
          <pane selection-relaxation-option='selection-relaxation-allow'>
            <view>
              <breakdown value='auto' />
            </view>
            <mark class='Automatic' />
            <mark-sizing mark-sizing-setting='marks-scaling-off' />
            <encodings>
              <color column='[federated.1tgqgev1fo243u19y7c690bbvb5r].[usr:Calculation_1161124440289283:nk]' />
            </encodings>
            <reference-line axis-column='[federated.1tgqgev1fo243u19y7c690bbvb5r].[avg:ROI (x):qk]' enable-instant-analytics='true' formula='average' id='refline0' label-type='automatic' probability='95' scope='per-pane' value-column='[federated.1tgqgev1fo243u19y7c690bbvb5r].[avg:ROI (x):qk]' z-order='1' />
            <reference-line axis-column='[federated.1tgqgev1fo243u19y7c690bbvb5r].[avg:ROI (x):qk]' enable-instant-analytics='true' formula='average' id='refline1' label-type='automatic' probability='95' scope='per-table' value-column='[federated.1tgqgev1fo243u19y7c690bbvb5r].[avg:ROI (x):qk]' z-order='2' />
            <style>
